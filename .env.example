# Provedor de roteiros: anthropic | gemini | groq | github
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=
CLAUDE_MODEL=claude-sonnet-4-5

# Provedor de vídeo: local ou fal
VIDEO_PROVIDER=local
FAL_KEY=
FAL_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video

# Voz opcional
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

MUSIC_FILE=
TRANSITION_SEC=0.25
MAX_SECONDS=60
SUB_FONT=Arial
DATA_DIR=/data

# Segurança do servidor (OBRIGATÓRIO): senha para entrar no app
ACCESS_PASSWORD=
# Opcional: segredo para assinar sessões (se vazio, usa a senha)
TOKEN_SECRET=
MAX_ACTIVE_JOBS=3
RETENTION_HOURS=48
